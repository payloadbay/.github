{
  "$schema": "./repository-baseline.schema.json",
  "organization": "payloadbay",
  "sourceRepository": ".github",
  "sourceBranch": "master",
  "rulesetPrefix": "baseline:",
  "statePath": ".github/.payloadbay-baseline.json",
  "syncBranch": "automation/repository-baseline",
  "managedAutolinkPrefixes": [
    "PAB-"
  ],
  "autolinks": [
    {
      "keyPrefix": "PAB-",
      "urlTemplate": "https://linear.app/thedannicraft/issue/PAB-<num>",
      "isAlphanumeric": false
    }
  ],
  "excludedRepositories": [],
  "managedFiles": [
    "AGENTS.md",
    ".github/ISSUE_TEMPLATE/bug-report.yml",
    ".github/ISSUE_TEMPLATE/feature-request.yml",
    ".github/ISSUE_TEMPLATE/planned-work.yml",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/pull_request_template.md",
    ".github/commitlint.config.mjs",
    ".github/labeler.yml",
    ".github/workflows/commitlint.yml",
    ".github/workflows/metadata-labeler.yml",
    ".github/workflows/planned-work-guard.yml",
    ".github/workflows/pr-quality.yml"
  ],
  "managedFileGroups": [
    {
      "name": "speckit",
      "repositories": [
        "payloadbay"
      ],
      "files": [
        ".github/speckit/README.md",
        ".github/speckit/setup.json",
        ".github/speckit/presets/payloadbay/preset.yml",
        ".github/speckit/presets/payloadbay/LICENSE",
        ".github/speckit/presets/payloadbay/templates/constitution-addendum.md",
        ".github/speckit/presets/payloadbay/templates/spec-addendum.md",
        ".github/speckit/presets/payloadbay/templates/plan-addendum.md",
        ".github/speckit/presets/payloadbay/templates/tasks-addendum.md",
        ".github/speckit/presets/payloadbay/commands/speckit.constitution.md",
        ".github/speckit/presets/payloadbay/commands/speckit.specify.md",
        ".github/speckit/presets/payloadbay/commands/speckit.plan.md",
        ".github/speckit/presets/payloadbay/commands/speckit.tasks.md",
        ".github/speckit/presets/payloadbay/commands/speckit.implement.md",
        ".github/speckit/presets/payloadbay/commands/speckit.analyze.md"
      ]
    }
  ],
  "renovate": {
    "preset": "local>payloadbay/.github:renovate-config",
    "bootstrapPath": "renovate.json",
    "configPaths": [
      "renovate.json",
      "renovate.json5",
      ".github/renovate.json",
      ".github/renovate.json5",
      "package.json"
    ]
  },
  "repositorySettings": {
    "default_branch": "master",
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "allow_update_branch": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "BLANK"
  }
}
