{
  "$schema": "./repository-baseline.schema.json",
  "organization": "payloadbay",
  "sourceRepository": ".github",
  "sourceBranch": "master",
  "rulesetPrefix": "baseline:",
  "statePath": ".github/.payloadbay-baseline.json",
  "syncBranch": "automation/repository-baseline",
  "managedAutolinkPrefixes": ["PAB-"],
  "autolinks": [
    {
      "keyPrefix": "PAB-",
      "urlTemplate": "https://linear.app/thedannicraft/issue/PAB-<num>",
      "isAlphanumeric": false
    }
  ],
  "excludedRepositories": [],
  "managedFiles": [
    "AGENTS.md",
    ".github/ISSUE_TEMPLATE/bug-report.yml",
    ".github/ISSUE_TEMPLATE/feature-request.yml",
    ".github/ISSUE_TEMPLATE/planned-work.yml",
    ".github/ISSUE_TEMPLATE/config.yml",
    ".github/pull_request_template.md",
    ".github/commitlint.config.mjs",
    ".github/labeler.yml",
    ".github/workflows/commitlint.yml",
    ".github/workflows/metadata-labeler.yml",
    ".github/workflows/planned-work-guard.yml",
    ".github/workflows/pr-quality.yml"
  ],
  "profiles": {
    "typescript": {
      "repositories": [],
      "managedFiles": [
        ".editorconfig",
        "biome.json",
        "tsconfig.json",
        "vitest.config.ts",
        ".vscode/settings.json",
        ".vscode/extensions.json",
        ".github/workflows/code-quality.yml",
        "fallow.toml"
      ],
      "package": {
        "packageManagerPrefix": "bun@",
        "requiredScripts": [
          "format",
          "format:check",
          "lint",
          "typecheck",
          "test",
          "test:coverage",
          "analyze",
          "analyze:audit",
          "analyze:dupes",
          "analyze:dead-code",
          "analyze:health",
          "analyze:security",
          "quality"
        ],
        "requiredDevDependencies": [
          "@biomejs/biome",
          "@types/bun",
          "@vitest/coverage-v8",
          "fallow",
          "typescript",
          "vitest"
        ]
      },
      "packagePatch": {
        "fields": {
          "packageManager": "bun@1.3.14",
          "type": "module"
        },
        "scripts": {
          "analyze": "fallow --production",
          "analyze:audit": "fallow audit --production",
          "analyze:dead-code": "fallow dead-code --production",
          "analyze:dupes": "fallow dupes --production --ci",
          "analyze:health": "fallow health --production",
          "analyze:security": "fallow security",
          "format": "biome format --write .",
          "format:check": "biome format .",
          "lint": "biome lint .",
          "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run analyze:audit && bun run analyze:dupes",
          "test": "vitest run",
          "test:coverage": "vitest run --coverage",
          "typecheck": "tsc --noEmit"
        },
        "devDependencies": {
          "@biomejs/biome": "2.5.6",
          "@types/bun": "1.3.14",
          "@vitest/coverage-v8": "4.1.10",
          "fallow": "3.12.0",
          "typescript": "7.0.2",
          "vitest": "4.1.10"
        }
      },
      "rulesets": [
        {
          "name": "baseline:typescript-quality",
          "target": "branch",
          "enforcement": "active",
          "bypass_actors": [
            {
              "actor_id": null,
              "actor_type": "OrganizationAdmin",
              "bypass_mode": "always"
            }
          ],
          "conditions": {
            "ref_name": {
              "include": ["~DEFAULT_BRANCH"],
              "exclude": []
            }
          },
          "rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "strict_required_status_checks_policy": true,
                "do_not_enforce_on_create": false,
                "required_status_checks": [
                  {
                    "context": "Code Quality",
                    "integration_id": 15368
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "renovate": {
    "preset": "local>payloadbay/.github:renovate-config",
    "bootstrapPath": "renovate.json",
    "configPaths": [
      "renovate.json",
      "renovate.json5",
      ".github/renovate.json",
      ".github/renovate.json5",
      "package.json"
    ]
  }
}
