{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "sourceRepository",
    "sourceBranch",
    "rulesetPrefix",
    "statePath",
    "syncBranch",
    "managedAutolinkPrefixes",
    "autolinks",
    "excludedRepositories",
    "managedFiles",
    "renovate"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceBranch": {
      "type": "string",
      "minLength": 1
    },
    "rulesetPrefix": {
      "type": "string",
      "minLength": 1
    },
    "statePath": {
      "type": "string",
      "minLength": 1
    },
    "syncBranch": {
      "type": "string",
      "minLength": 1
    },
    "managedAutolinkPrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "autolinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyPrefix", "urlTemplate", "isAlphanumeric"],
        "properties": {
          "keyPrefix": {
            "type": "string",
            "minLength": 1
          },
          "urlTemplate": {
            "type": "string",
            "minLength": 1,
            "pattern": "<num>"
          },
          "isAlphanumeric": {
            "type": "boolean"
          }
        }
      }
    },
    "excludedRepositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositories", "managedFiles", "package", "rulesets"],
        "properties": {
          "repositories": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "managedFiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packageManagerPrefix",
              "requiredScripts",
              "requiredDevDependencies"
            ],
            "properties": {
              "packageManagerPrefix": { "type": "string", "minLength": 1 },
              "requiredScripts": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              },
              "requiredDevDependencies": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "rulesets": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "renovate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "bootstrapPath", "configPaths"],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapPath": {
          "type": "string",
          "minLength": 1
        },
        "configPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
