{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "sourceRepository",
    "sourceBranch",
    "rulesetPrefix",
    "statePath",
    "syncBranch",
    "managedAutolinkPrefixes",
    "autolinks",
    "excludedRepositories",
    "managedFiles",
    "renovate",
    "repositorySettings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceBranch": {
      "type": "string",
      "minLength": 1
    },
    "rulesetPrefix": {
      "type": "string",
      "minLength": 1
    },
    "statePath": {
      "type": "string",
      "minLength": 1
    },
    "syncBranch": {
      "type": "string",
      "minLength": 1
    },
    "managedAutolinkPrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "autolinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyPrefix",
          "urlTemplate",
          "isAlphanumeric"
        ],
        "properties": {
          "keyPrefix": {
            "type": "string",
            "minLength": 1
          },
          "urlTemplate": {
            "type": "string",
            "minLength": 1,
            "pattern": "<num>"
          },
          "isAlphanumeric": {
            "type": "boolean"
          }
        }
      }
    },
    "excludedRepositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "managedFileGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repositories",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "renovate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "bootstrapPath",
        "configPaths"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapPath": {
          "type": "string",
          "minLength": 1
        },
        "configPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "repositorySettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_branch",
        "allow_squash_merge",
        "allow_merge_commit",
        "allow_rebase_merge",
        "allow_auto_merge",
        "delete_branch_on_merge",
        "allow_update_branch",
        "squash_merge_commit_title",
        "squash_merge_commit_message"
      ],
      "properties": {
        "allow_squash_merge": {
          "type": "boolean"
        },
        "allow_merge_commit": {
          "type": "boolean"
        },
        "allow_rebase_merge": {
          "type": "boolean"
        },
        "allow_auto_merge": {
          "type": "boolean"
        },
        "delete_branch_on_merge": {
          "type": "boolean"
        },
        "allow_update_branch": {
          "type": "boolean"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "squash_merge_commit_title": {
          "enum": [
            "PR_TITLE"
          ]
        },
        "squash_merge_commit_message": {
          "enum": [
            "BLANK"
          ]
        }
      }
    },
    "managedEnvironments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repositories",
          "reviewers",
          "preventSelfReview"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "preventSelfReview": {
            "type": "boolean"
          },
          "reviewers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "login",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "User"
                },
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
                },
                "id": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
