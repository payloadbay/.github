{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "organization",
    "sourceRepository",
    "sourceBranch",
    "moduleConfigPath",
    "rulesetPrefix",
    "statePath",
    "syncBranch",
    "managedAutolinkPrefixes",
    "autolinks",
    "excludedRepositories",
    "managedFiles",
    "modules",
    "renovate"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "organization": {
      "type": "string",
      "minLength": 1
    },
    "sourceRepository": {
      "type": "string",
      "minLength": 1
    },
    "sourceBranch": {
      "type": "string",
      "minLength": 1
    },
    "moduleConfigPath": {
      "type": "string",
      "minLength": 1
    },
    "rulesetPrefix": {
      "type": "string",
      "minLength": 1
    },
    "statePath": {
      "type": "string",
      "minLength": 1
    },
    "syncBranch": {
      "type": "string",
      "minLength": 1
    },
    "managedAutolinkPrefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "autolinks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyPrefix", "urlTemplate", "isAlphanumeric"],
        "properties": {
          "keyPrefix": {
            "type": "string",
            "minLength": 1
          },
          "urlTemplate": {
            "type": "string",
            "minLength": 1,
            "pattern": "<num>"
          },
          "isAlphanumeric": {
            "type": "boolean"
          }
        }
      }
    },
    "excludedRepositories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requires",
          "managedFiles",
          "packagePatch",
          "rulesets"
        ],
        "properties": {
          "requires": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "managedFiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "packagePatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fields", "scripts", "devDependencies"],
            "properties": {
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": ["string", "boolean", "number"]
                }
              },
              "scripts": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "devDependencies": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          },
          "rulesets": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "renovate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "bootstrapPath", "configPaths"],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "bootstrapPath": {
          "type": "string",
          "minLength": 1
        },
        "configPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
